<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF8F5">

    <!-- Cabeçalho Valorizado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2C3E50"
        android:paddingStart="16dp"
        android:paddingEnd="10dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bíblia Almeida ARC-1911"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Atualização ortográfica e gramatical • Edição 11/2026"
                android:textColor="#F7DC6F"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTituloCapitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Gênesis • Capítulo 1"
                android:textColor="#EAECEE"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSobre"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="ⓘ"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Barra de Seleção (Testamento, Livro e Capítulo) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#EAECEE">

        <Button
            android:id="@+id/btnTestamento"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="0.75"
            android:layout_marginEnd="4dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:maxLines="1"
            android:text="AT"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLivro"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.85"
            android:layout_marginEnd="4dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Gênesis"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <Button
            android:id="@+id/btnCapitulo"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.0"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:maxLines="1"
            android:text="Cap. 1"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Área de Leitura do Texto Bíblico -->
    <ScrollView
        android:id="@+id/scrollLeitura"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/tvTextoBiblico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Carregando..."
            android:textColor="#1C2833"
            android:textSize="18sp"
            android:lineSpacingMultiplier="1.35"
            android:textIsSelectable="true" />
    </ScrollView>

    <!-- Barra Inferior (Navegação, Zoom da Fonte e Enviar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp"
        android:background="#EAECEE">

        <Button
            android:id="@+id/btnAnterior"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.15"
            android:layout_marginEnd="4dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:maxLines="1"
            android:text="&lt; Ant."
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnFonteMenor"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="0.75"
            android:layout_marginEnd="4dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:maxLines="1"
            android:text="A-"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnFonteMaior"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="0.75"
            android:layout_marginEnd="4dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:maxLines="1"
            android:text="A+"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnCompartilhar"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.2"
            android:layout_marginEnd="4dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:maxLines="1"
            android:text="Enviar"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnProximo"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.15"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:maxLines="1"
            android:text="Próx. &gt;"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
